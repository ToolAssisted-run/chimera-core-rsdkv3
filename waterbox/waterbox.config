{
  "coreName": "rsdkv3",
  "systemNames": {
    "SonicCD": "Sonic CD"
  },
  "kind": "game",
  "systemId": "SonicCD",
  "_system_note": "The Retro Engine v3 decompilation plays Sonic CD's 2011 remake, whose data file the project brings as firmware. The engine plays any v3 data file; the one it was made for is Sonic CD's, so that is the system.",
  "author": "Christian Whitehead (Retro Engine); the RSDKv3 decompilation by Rubberduckycooly and st×tic; chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-rsdkv3",
  "deterministic": true,
  "_memory_note": "[sbrk, sealed, invisible, plain, mmap] MiB: the engine's own memory (its screen buffers, sprite sheets, the music track being played, which it decodes from memory, and its sound effects) on the heap; the game's data file in sealed memory, read-only after Init and so in no savestate (the Android release's is 74 MiB); C++ and SDL's larger allocations mmap'd. A savestate of Sonic CD in play is 6.5 MB.",
  "memoryLayoutMiB": [
    256,
    1024,
    4,
    4,
    512
  ],
  "video": {
    "_comment": "The engine's own software screen, as upstream's SDL frontend shows it: 240 lines, as wide as the Screen Width setting (424 by default, a 16:9 picture of square pixels), in 16-bit colour. On the frames the engine draws at twice the size (Sonic CD's special stages, with the High Resolution Modes setting) the picture is twice the size each way; the live size comes from GetVideoWidth/Height.",
    "width": 848,
    "height": 480,
    "virtualWidth": 424,
    "virtualHeight": 240,
    "vsyncNumerator": 60,
    "vsyncDenominator": 1,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "The engine's own mixer (its music, decoded from the data file's Ogg Vorbis tracks, and its sound effects), run for exactly one sixtieth of a second each frame: 735 stereo samples at 44100 Hz.",
    "rate": 44100,
    "samplesPerFrame": 735,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "input": {
    "name": "Sonic CD",
    "_comment": "The engine's eight inputs, which every game made with it reads: the pad's directions, its A, B and C buttons (in Sonic CD each one jumps) and Start. The engine reads them at the start of each frame from the keyboard, where they are the arrows, Z, X, C and Enter. The Android release's menus also read the pad: a direction first, then A.",
    "buttons": [
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 A",
      "P1 B",
      "P1 C",
      "P1 Start"
    ],
    "mnemonics": {
      "Up": "U",
      "Down": "D",
      "Left": "L",
      "Right": "R",
      "A": "A",
      "B": "B",
      "C": "C",
      "Start": "S"
    }
  },
  "settings": [
    {
      "name": "language",
      "display": "Language",
      "type": "enum",
      "options": [
        "en",
        "fr",
        "it",
        "de",
        "es",
        "ja"
      ],
      "default": "en",
      "description": "The language the game's texts are in (the engine's Language setting): English, French, Italian, German, Spanish or Japanese. The game's scripts read it, so a movie records it.",
      "optionLabels": {
        "en": "English",
        "fr": "French",
        "it": "Italian",
        "de": "German",
        "es": "Spanish",
        "ja": "Japanese"
      }
    },
    {
      "name": "screenWidth",
      "display": "Screen Width",
      "type": "int",
      "default": 424,
      "min": 320,
      "max": 424,
      "description": "How many pixels wide the screen is (the engine's ScreenWidth setting). 424 is upstream's default, a 16:9 screen; 320 is the 4:3 screen of the original 1993 game. The width changes how far ahead the player sees and which objects are awake, so it changes the game, and a movie records it."
    },
    {
      "name": "hqModes",
      "display": "High Resolution Modes",
      "type": "bool",
      "default": true,
      "description": "Draws the special stages' floor at twice the resolution, as upstream does by default (the engine's UseHQModes setting). The picture is then twice the size on those frames. It changes the picture only."
    },
    {
      "name": "controls",
      "display": "Original Controls",
      "type": "enum",
      "options": [
        "game",
        "original",
        "modern"
      ],
      "default": "game",
      "description": "The engine's OriginalControls setting, which the game reads as its controls option (saved game byte 35 and the variable Options.OriginalControls). \"game\" leaves it to the game's own Options menu, as upstream does by default; \"original\" sets it on and \"modern\" off whatever the menu says. It changes play, so a movie records it.",
      "optionLabels": {
        "game": "The game's own option",
        "original": "On",
        "modern": "Off"
      }
    },
    {
      "name": "randomSeed",
      "display": "Random Seed",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 2147483647,
      "description": "The number the engine's random numbers start from. The engine takes it from the clock when it starts (time()); here it is this number, so a movie plays the same every time. A movie records it."
    }
  ],
  "firmware": [
    {
      "id": "Data.rsdk",
      "display": "Sonic CD data file (Data.rsdk)",
      "description": "The data file of Sonic CD's 2011 release: everything the game is (its scripts, pictures, music and sounds). The copy that was checked is the Android release's: in its APK it is assets/Data.xmf, which is this file under another name. The Steam release's Data.rsdk is the same kind of file. You have to supply it, because this package includes none of the game's files. A file of your own can be used in its place, and the project then records its hash.",
      "sha1": "520B69826B5FEA7AFA1C49B6AD5E5091D44C9601",
      "name": "Data.rsdk"
    }
  ]
}
